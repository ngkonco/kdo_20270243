#--------------------------------------------------------------------
# APLIKASI KDO - BARANG MILIK DAERAH (BMD)
# Environment Configuration
#--------------------------------------------------------------------

# Environment mode
CI_ENVIRONMENT = development

# App Settings
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'

# Database Configuration (Docker container db)
database.default.hostname = db
database.default.database = kdo_bmd
database.default.username = kdo_user
database.default.password = kdo_password_2026
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Security & CSRF Settings
security.csrfProtection = 'cookie'
security.tokenRandomize = false
security.tokenName = 'csrf_kdo_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_kdo_cookie'
security.expires = 7200
security.regenerate = true
security.redirect = false

